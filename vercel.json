{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sebas3261.com"
        }
      ],
      "destination": "https://sebas3261.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "headers": { "Location": "/en/" },
      "status": 307
    },
    { "handle": "filesystem" },
    {
      "src": "^/es(?:/.*)?$",
      "dest": "/es/404/index.html",
      "status": 404
    },
    {
      "src": "^/en(?:/.*)?$",
      "dest": "/en/404/index.html",
      "status": 404
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
