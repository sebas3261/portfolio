---
import en from "../messages/en/navbar.json";
import es from "../messages/es/navbar.json";
import Footer from "../components/Footer.astro";

const { lang, messages, noindex = false } = Astro.props;
const navMessages = lang === "es" ? es : en;

const normalizedPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(normalizedPath, Astro.site);
const englishPath = normalizedPath.replace(/^\/(en|es)(?=\/|$)/, "/en");
const spanishPath = normalizedPath.replace(/^\/(en|es)(?=\/|$)/, "/es");
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{messages.title}</title>
    <meta name="description" content={messages.description} />
    <meta name="author" content="Sebastian Sanchez" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    {!noindex && <>
    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Languages -->
    <link rel="alternate" hreflang="en" href={new URL(englishPath, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(spanishPath, Astro.site)} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(englishPath, Astro.site)}
    />

    </>}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Anti-flash: aplica el tema antes de que React hidrate -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var dark = stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) {
          document.documentElement.classList.add("dark");
          document.documentElement.style.colorScheme = "dark";
        } else {
          document.documentElement.style.colorScheme = "light";
        }
      })();
    </script>

    {!noindex && <>
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={messages.ogTitle} />
    <meta property="og:description" content={messages.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sebastian Sanchez" />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "es" ? "en_US" : "es_CO"}
    />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={messages.ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={messages.ogTitle} />
    <meta name="twitter:description" content={messages.ogDescription} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />
    <meta name="twitter:image:alt" content={messages.ogImageAlt} />
    </>}
  </head>
  <body>
    <slot />
    <Footer lang={lang} navLinks={navMessages.links} />
  </body>
</html>
