---
import navbarEn from "../messages/en/navbar.json";
import navbarEs from "../messages/es/navbar.json";
import footerEn from "../messages/en/footer.json";
import footerEs from "../messages/es/footer.json";
import Footer from "../components/Footer.astro";

const { lang, messages, noindex = false } = Astro.props;
const navMessages = lang === "es" ? navbarEs : navbarEn;
const footerMessages = lang === "es" ? footerEs : footerEn;

const normalizedPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(normalizedPath, Astro.site);
const englishPath = normalizedPath.replace(/^\/(en|es)(?=\/|$)/, "/en");
const spanishPath = normalizedPath.replace(/^\/(en|es)(?=\/|$)/, "/es");
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{messages.title}</title>
    <meta name="description" content={messages.description} />
    <meta name="author" content="Sebastian Sanchez" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    {!noindex && <>
    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Languages -->
    <link rel="alternate" hreflang="en" href={new URL(englishPath, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(spanishPath, Astro.site)} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(englishPath, Astro.site)}
    />

    </>}

    <!-- Favicons -->
    <link rel="icon" href="/favicon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Anti-flash: aplica el tema antes de que React hidrate -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var dark = stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) {
          document.documentElement.classList.add("dark");
          document.documentElement.style.colorScheme = "dark";
        } else {
          document.documentElement.style.colorScheme = "light";
        }
      })();
    </script>

    {!noindex && <>
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={messages.ogTitle} />
    <meta property="og:description" content={messages.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sebastian Sanchez" />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "es" ? "en_US" : "es_CO"}
    />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={messages.ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={messages.ogTitle} />
    <meta name="twitter:description" content={messages.ogDescription} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />
    <meta name="twitter:image:alt" content={messages.ogImageAlt} />
    </>}
  </head>
  <body>
    <slot />
    <Footer lang={lang} navLinks={navMessages.links} messages={footerMessages} />
    <script is:inline>
      (function () {
        var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var sections = Array.prototype.slice.call(document.querySelectorAll("main > section"));
        var revealTargets = sections
          .map(function (section) {
            return section.firstElementChild || section;
          })
          .filter(function (target, index, array) {
            return array.indexOf(target) === index;
          });

        revealTargets.forEach(function (target) {
          target.setAttribute("data-reveal-content", "");
          var children = Array.prototype.slice.call(target.children);

          if (!children.length) {
            target.setAttribute("data-reveal-self", "");
            return;
          }

          children.slice(0, 8).forEach(function (child, index) {
            child.setAttribute("data-reveal-item", "");
            child.style.setProperty("--reveal-delay", Math.min(index * 90, 360) + "ms");
          });
        });

        if (reduceMotion || !("IntersectionObserver" in window)) {
          revealTargets.forEach(function (target) {
            target.classList.add("is-visible");
          });
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.16,
            rootMargin: "0px 0px -8% 0px",
          },
        );

        revealTargets.forEach(function (target) {
          observer.observe(target);
        });
      })();
    </script>
  </body>
</html>
