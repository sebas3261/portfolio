---
import { codeToHtml } from "shiki";

interface Props {
  blocks: Record<string, any>[];
}

const { blocks } = Astro.props;

const languageMap: Record<string, string> = {
  "c++": "cpp",
  "c#": "csharp",
  "java/c/c++/c#": "java",
  javascript: "js",
  typescript: "ts",
  shell: "bash",
  plain_text: "text",
};

function normalizeLanguage(language: string | undefined): string {
  if (!language) return "text";
  const normalized = language.toLowerCase().trim();
  return languageMap[normalized] ?? normalized;
}

function escapeAttribute(value: string): string {
  return value.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
}

async function highlightCode(code: string, language: string): Promise<string> {
  const normalizedLanguage = normalizeLanguage(language);

  try {
    const html = await codeToHtml(code, {
      lang: normalizedLanguage,
      theme: "github-dark-default",
    });

    return html.replace("<pre", `<pre data-language="${escapeAttribute(language)}"`);
  } catch {
    const fallback = await codeToHtml(code, {
      lang: "text",
      theme: "github-dark-default",
    });

    return fallback.replace("<pre", `<pre data-language="${escapeAttribute(language || "code")}"`);
  }
}

function richText(items: any[] = []) {
  return items.map((item) => {
    const text = item.plain_text ?? "";
    const href = item.href;
    const annotations = item.annotations ?? {};
    let className = "";

    if (annotations.bold) className += " font-semibold";
    if (annotations.italic) className += " italic";
    if (annotations.code) className += " rounded bg-zinc-100 px-1 py-0.5 font-mono text-sm dark:bg-zinc-900";

    return { text, href, className: className.trim() };
  });
}

function externalUrl(block: any): string | undefined {
  const data = block[block.type];
  if (!data) return undefined;
  if (data.type === "external") return data.external?.url;
  if (data.type === "file") return data.file?.url;
  if (data.url) return data.url;
  return undefined;
}

function youtubeEmbed(url: string): string | undefined {
  try {
    const parsed = new URL(url);
    if (!["https:", "http:"].includes(parsed.protocol)) return undefined;

    const host = parsed.hostname.toLowerCase();
    const segments = parsed.pathname.split("/").filter(Boolean);
    let id: string | null | undefined;

    if (host === "youtu.be") {
      id = segments[0];
    } else if (["youtube.com", "www.youtube.com", "m.youtube.com", "youtube-nocookie.com", "www.youtube-nocookie.com"].includes(host)) {
      if (segments[0] === "watch") id = parsed.searchParams.get("v");
      else if (["embed", "shorts", "live"].includes(segments[0])) id = segments[1];
    }

    return id && /^[A-Za-z0-9_-]{11}$/.test(id)
      ? `https://www.youtube-nocookie.com/embed/${id}`
      : undefined;
  } catch {
    return undefined;
  }
}

const renderedBlocks = await Promise.all(
  blocks.map(async (block) => {
    if (block.type !== "code") return block;

    const data = block[block.type] ?? {};
    const code = data.rich_text?.map((part: any) => part.plain_text ?? "").join("") ?? "";
    const language = data.language || "code";

    return {
      ...block,
      highlightedCodeHtml: await highlightCode(code, language),
    };
  }),
);
---

{renderedBlocks.map((block) => {
  const data = block[block.type] ?? {};
  const text = richText(data.rich_text);

  if (block.type === "column_list") {
    const columns = (block.children ?? []).filter((child: any) => child.type === "column");
    const videoColumn = columns.length === 2 ? columns.findIndex((column: any) => {
      const content = (column.children ?? []).filter((child: any) =>
        child.type !== "paragraph" || (child.paragraph?.rich_text ?? []).some((part: any) => part.plain_text?.trim())
      );
      if (content.length !== 1 || !["video", "embed", "bookmark"].includes(content[0].type)) return false;
      const url = externalUrl(content[0]);
      return url && youtubeEmbed(url) && new URL(url).pathname.startsWith("/shorts/");
    }) : -1;
    return columns.length > 0 ? (
      <div class:list={[
        "notion-columns",
        { "notion-columns--video-left": videoColumn === 0, "notion-columns--video-right": videoColumn === 1 },
      ]} style={`--notion-column-count: ${columns.length}`}>
        {(videoColumn === 1 ? [columns[1], columns[0]] : columns).map((column: any) => (
          <div class:list={["notion-column", {
            "notion-column--video": videoColumn === 1 && column === columns[1],
            "notion-column--flow": videoColumn === 1 && column === columns[0],
          }]}>
            <Astro.self blocks={column.children ?? []} />
          </div>
        ))}
      </div>
    ) : null;
  }

  if (block.type === "paragraph" && text.length === 0) {
    return <div class="h-6"></div>;
  }

  if (block.type === "paragraph") {
    return (
      <p>
        {text.map((part) =>
          part.href ? <a href={part.href} class={part.className}>{part.text}</a> : <span class={part.className}>{part.text}</span>
        )}
      </p>
    );
  }

  if (block.type === "heading_2") {
    return <h2>{text.map((part) => <span class={part.className}>{part.text}</span>)}</h2>;
  }

  if (block.type === "heading_3") {
    return <h3>{text.map((part) => <span class={part.className}>{part.text}</span>)}</h3>;
  }

  if (block.type === "bulleted_list_item") {
    return <ul><li>{text.map((part) => <span class={part.className}>{part.text}</span>)}</li></ul>;
  }

  if (block.type === "numbered_list_item") {
    return <ol><li>{text.map((part) => <span class={part.className}>{part.text}</span>)}</li></ol>;
  }

  if (block.type === "quote") {
    return <blockquote>{text.map((part) => <span class={part.className}>{part.text}</span>)}</blockquote>;
  }

  if (block.type === "code") {
    return <Fragment set:html={block.highlightedCodeHtml} />;
  }

  if (block.type === "image") {
    const src = externalUrl(block);
    const caption = richText(data.caption);
    return src ? (
      <figure>
        <img src={src} alt={caption.map((part) => part.text).join(" ") || ""} loading="lazy" decoding="async" />
        {caption.length > 0 && <figcaption>{caption.map((part) => <span class={part.className}>{part.text}</span>)}</figcaption>}
      </figure>
    ) : null;
  }

  if (["video", "embed", "bookmark"].includes(block.type)) {
    const url = externalUrl(block);
    const embed = url ? youtubeEmbed(url) : undefined;

    if (embed) {
      const isShort = new URL(url!).pathname.startsWith("/shorts/");
      return (
        <figure class="my-10">
          <div class:list={[
            "overflow-hidden bg-zinc-950 shadow-xl shadow-zinc-950/10 dark:shadow-black/30",
            isShort ? "mx-auto aspect-[9/16] w-full max-w-[340px] rounded-2xl" : "aspect-video rounded-sm",
          ]}>
            <iframe
              src={embed}
              title="YouTube video"
              class="h-full w-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </figure>
      );
    }

    return url ? <p><a href={url}>{url}</a></p> : null;
  }

  return null;
})}

<style is:global>
  .notion-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .notion-column {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .notion-column > * + * {
    margin-top: 1.5rem;
  }

  .blog-content .notion-column > :first-child {
    margin-top: 0;
  }

  .notion-column > figure:last-child {
    margin-bottom: 0;
  }

  .notion-columns--video-right > .notion-column--video {
    order: 2;
  }

  @media (min-width: 768px) {
    .notion-columns {
      grid-template-columns: repeat(var(--notion-column-count), minmax(0, 1fr));
      gap: 3rem;
    }

    .notion-columns--video-right {
      display: flow-root;
    }

    .notion-columns--video-right > .notion-column--video {
      float: right;
      width: 15rem;
      margin: 0 0 1.5rem 3rem;
    }

    .notion-columns--video-right > .notion-column--flow {
      display: contents;
    }

    .notion-columns--video-left {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }
</style>
