---
import NavBarReact from "./NavBar";
import en from "../messages/en/navbar.json";
import es from "../messages/es/navbar.json";

const { lang = "en", variant = "default" } = Astro.props;
const messages = lang === "es" ? es : en;
const currentPath = Astro.url.pathname;
---

<NavBarReact
  client:load
  lang={lang}
  messages={messages}
  currentPath={currentPath}
  variant={variant}
/>
