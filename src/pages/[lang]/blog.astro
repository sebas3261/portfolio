---
import "../../styles/global.css";
import en from "../../messages/en/blog.json";
import es from "../../messages/es/blog.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogExplorer from "../../components/BlogExplorer";
import NavBar from "../../components/NavBar.astro";
import { getBlogPosts } from "../../lib/blog";

export const prerender = false;

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;
const posts = (await getBlogPosts())
  .filter((post) => post.lang === lang)
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const formatter = new Intl.DateTimeFormat(lang === "es" ? "es-CO" : "en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const explorerPosts = posts.map((post) => ({
  slug: post.slug,
  title: post.title,
  description: post.description,
  date: post.date.toISOString(),
  formattedDate: formatter.format(post.date),
  cover: post.cover,
  coverAlt: post.coverAlt,
  tags: post.tags,
}));
---

<BaseLayout lang={lang} messages={messages}>
  <NavBar lang={lang} />

  <main class="bg-white text-zinc-950 dark:bg-zinc-950 dark:text-white">

    <!-- Header -->
    <section class="bg-zinc-50 px-6 pb-16 pt-28 dark:bg-zinc-900/40 sm:pb-20 sm:pt-40">
      <div class="mx-auto max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-sky-500 dark:text-sky-400">
          {messages.eyebrow}
        </p>
        <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl lg:text-7xl">
          {messages.heading}
        </h1>
        <span class="mt-6 block h-1 w-24 bg-gradient-to-r from-sky-400 via-violet-400 to-emerald-400"></span>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-500 dark:text-zinc-400">
          {messages.intro}
        </p>
      </div>
    </section>

    <section class="border-t border-zinc-200 px-6 py-16 dark:border-zinc-800 sm:py-20">
      <div class="mx-auto max-w-4xl">
        {posts.length > 0 ? (
          <BlogExplorer client:load lang={lang} posts={explorerPosts} messages={messages.explorer} />
        ) : (
          <div class="max-w-lg">
            <h2 class="text-xl font-semibold">{messages.emptyState.title}</h2>
            <p class="mt-3 leading-7 text-zinc-500 dark:text-zinc-400">
              {messages.emptyState.body}
            </p>
            <div class="mt-6 flex flex-wrap gap-2">
              {messages.emptyState.topics.map((topic) => (
                <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs font-medium text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
                  {topic}
                </span>
              ))}
            </div>
          </div>
        )}

      </div>
    </section>

  </main>
</BaseLayout>
