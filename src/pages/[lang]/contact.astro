---
import "../../styles/global.css";
import en from "../../messages/en/contact.json";
import es from "../../messages/es/contact.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/NavBar.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;
const emailHref = `mailto:${messages.email}`;
---

<BaseLayout lang={lang} messages={messages}>
  <NavBar lang={lang} />

  <main class="bg-white text-zinc-950 dark:bg-zinc-950 dark:text-white">
    <section class="bg-zinc-50 px-6 pb-16 pt-28 dark:bg-zinc-900/40 sm:pb-24 sm:pt-40">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-sky-500 dark:text-sky-400">
          {messages.eyebrow}
        </p>
        <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight sm:text-6xl lg:text-7xl">
          {messages.heading}
        </h1>
        <span class="mt-6 block h-1 w-24 bg-gradient-to-r from-sky-400 via-violet-400 to-emerald-400"></span>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
          {messages.intro}
        </p>
      </div>

      <aside class="border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
        <div>
          <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{messages.emailLabel}</p>
          <a
            href={emailHref}
            class="mt-2 block break-words text-2xl font-semibold text-zinc-950 transition-colors hover:text-sky-600 dark:text-white dark:hover:text-sky-300"
          >
            {messages.email}
          </a>
        </div>

        <div class="mt-6 border-t border-zinc-200 pt-6 dark:border-zinc-800">
          <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{messages.availabilityLabel}</p>
          <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">
            {messages.availability}
          </p>
          <p class="mt-4 text-sm leading-6 text-zinc-500 dark:text-zinc-500">
            {messages.response}
          </p>
        </div>

        <a
          href={emailHref}
          class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-zinc-950 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
        >
          {messages.cta}
          <span aria-hidden="true">→</span>
        </a>

        <div class="mt-8 border-t border-zinc-200 pt-6 dark:border-zinc-800">
          <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{messages.linksLabel}</p>
          <div class="mt-3 flex flex-wrap gap-3">
            <a
              href="https://github.com/sebas3261"
              target="_blank"
              rel="noreferrer"
              class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition-colors hover:bg-white dark:border-zinc-700 dark:hover:bg-zinc-800"
            >
              {messages.links.github}
            </a>
            <a
              href="https://www.linkedin.com/in/sebastian-sanchez-sandoval"
              target="_blank"
              rel="noreferrer"
              class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition-colors hover:bg-white dark:border-zinc-700 dark:hover:bg-zinc-800"
            >
              {messages.links.linkedin}
            </a>
          </div>
        </div>
      </aside>
      </div>
    </section>

    <section class="border-t border-zinc-200 bg-white px-6 py-14 dark:border-zinc-800 dark:bg-zinc-950 sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <h2 class="border-l-2 border-violet-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.workLabel}
        </h2>
        <div class="grid gap-px bg-zinc-200 dark:bg-zinc-800 sm:grid-cols-2">
          {messages.work.map((item, index) => {
            const lines = ["bg-sky-400", "bg-violet-400", "bg-emerald-400", "bg-rose-400"];
            return (
              <div class="bg-white p-6 dark:bg-zinc-950">
                <span class={`mb-5 block h-1 w-12 ${lines[index]}`}></span>
                <p class="text-lg font-semibold leading-7">{item}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="border-t border-zinc-200 bg-zinc-100 px-6 py-14 dark:border-zinc-800 dark:bg-zinc-900/40 sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <h2 class="border-l-2 border-emerald-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.processLabel}
        </h2>
        <div class="grid gap-8 sm:grid-cols-3">
          {messages.process.map((step, index) => (
            <div class="border-t border-zinc-300 pt-5 dark:border-zinc-800">
              <p class="text-sm font-semibold text-emerald-500">0{index + 1}</p>
              <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
              <p class="mt-3 leading-7 text-zinc-600 dark:text-zinc-400">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
