---
import "../../styles/global.css";
import en from "../../messages/en/contact.json";
import es from "../../messages/es/contact.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/NavBar.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;
const emailHref = `mailto:${messages.email}`;
---

<BaseLayout lang={lang} messages={messages}>
  <NavBar lang={lang} />

  <main class="bg-white text-zinc-950 dark:bg-zinc-950 dark:text-white">
    <section class="relative isolate overflow-hidden px-6 pt-28 pb-12 sm:pt-36 sm:pb-16">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.08),transparent_60%)]"></div>
      <div class="mx-auto max-w-7xl">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-indigo-500 dark:text-indigo-300">{messages.eyebrow}</p>
        <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">{messages.heading}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-500 dark:text-zinc-400">{messages.intro}</p>
        <p class="mt-6 text-xs font-medium uppercase tracking-[0.15em] text-zinc-400">{messages.location}</p>
      </div>
    </section>

    <section class="px-6 pb-16 sm:pb-20">
      <div class="mx-auto grid max-w-7xl gap-6 md:grid-cols-2">
        <article class="flex flex-col rounded-2xl border border-zinc-200 bg-zinc-50/70 p-6 dark:border-zinc-800 dark:bg-zinc-900/40 sm:p-9">
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-zinc-400">{messages.personal.label}</p>
          <div class="mt-6 flex items-center gap-4">
            <img src="/images/about/sebastian.jpg" alt="" width="64" height="64" class="size-16 rounded-full object-cover object-[50%_85%]" />
            <h2 class="text-2xl font-semibold tracking-tight">{messages.personal.title}</h2>
          </div>
          <p class="mt-5 max-w-lg text-sm leading-7 text-zinc-500 dark:text-zinc-400">{messages.personal.body}</p>
          <a href={emailHref} class="mt-6 w-fit break-all text-xl font-semibold tracking-tight transition-colors hover:text-indigo-500 sm:text-2xl">{messages.email}</a>
          <div class="mt-auto pt-8">
            <a href={emailHref} class="inline-flex items-center gap-3 rounded-full bg-zinc-950 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-600 dark:bg-white dark:text-zinc-950 dark:hover:bg-indigo-200">{messages.personal.cta}<span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <article class="flex flex-col rounded-2xl border border-indigo-400/20 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.16),transparent_70%)] bg-zinc-950 p-6 text-white sm:p-9">
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-indigo-300">{messages.company.label}</p>
          <div class="mt-6 flex items-center gap-4">
            <img src="/images/vaul/vaul-white.svg" alt="" width="64" height="40" class="h-10 w-16 object-contain" />
            <h2 class="text-2xl font-semibold tracking-tight">{messages.company.title}</h2>
          </div>
          <p class="mt-5 max-w-lg text-sm leading-7 text-zinc-400">{messages.company.body}</p>
          <a href={`mailto:${messages.company.email}`} class="mt-6 w-fit break-all text-xl font-semibold tracking-tight transition-colors hover:text-indigo-300 sm:text-2xl">{messages.company.email}</a>
          <div class="mt-auto pt-8">
            <a href={`https://vaulsoftware.com/${lang}/contact/`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-full border border-white/20 px-5 py-3 text-sm font-semibold transition-colors hover:border-indigo-300 hover:bg-white/5">{messages.company.cta}<span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </div>
    </section>

    <section class="border-t border-zinc-200 px-6 py-14 dark:border-zinc-800 sm:py-16">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-500 dark:text-indigo-300">{messages.brief.eyebrow}</p>
          <h2 class="mt-4 max-w-md text-3xl font-semibold tracking-tight">{messages.brief.title}</h2>
          <p class="mt-4 max-w-md text-sm leading-7 text-zinc-500 dark:text-zinc-400">{messages.brief.intro}</p>
        </div>
        <ol class="space-y-5">
          {messages.brief.items.map((item, index) => <li class="flex gap-5 border-t border-zinc-200 pt-5 dark:border-zinc-800"><span class="text-xs font-semibold text-indigo-500 dark:text-indigo-300">0{index + 1}</span><div><h3 class="font-semibold">{item.title}</h3><p class="mt-2 text-sm leading-6 text-zinc-500 dark:text-zinc-400">{item.body}</p></div></li>)}
        </ol>
      </div>
    </section>
    <section class="border-t border-zinc-200 px-6 py-8 dark:border-zinc-800">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5">
        <p class="text-sm text-zinc-500 dark:text-zinc-400">{messages.linksLabel}</p>
        <div class="flex items-center gap-6 text-sm font-semibold">
          <a href={`/${lang}/projects/`} class="hover:text-indigo-500">{lang === "es" ? "Proyectos" : "Projects"} ↗</a>
          <a href="https://github.com/sebas3261" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-500">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/sebastian-sanchez-sandoval" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-500">LinkedIn ↗</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
