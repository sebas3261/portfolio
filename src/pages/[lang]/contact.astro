---
import "../../styles/global.css";
import en from "../../messages/en/contact.json";
import es from "../../messages/es/contact.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/NavBar.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;
const emailHref = `mailto:${messages.email}`;
---

<BaseLayout lang={lang} messages={messages}>
  <NavBar lang={lang} />

  <main class="min-h-screen bg-white px-6 py-32 text-zinc-950 dark:bg-zinc-950 dark:text-white">
    <section class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[1fr_0.8fr] lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-zinc-500 dark:text-zinc-400">
          {messages.eyebrow}
        </p>
        <h1 class="mt-5 max-w-3xl text-5xl font-bold tracking-tight sm:text-7xl">
          {messages.heading}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
          {messages.intro}
        </p>
      </div>

      <aside class="rounded-lg border border-zinc-200 p-6 dark:border-zinc-800">
        <div>
          <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{messages.emailLabel}</p>
          <a
            href={emailHref}
            class="mt-2 block break-words text-xl font-semibold text-zinc-950 transition-colors hover:text-zinc-500 dark:text-white dark:hover:text-zinc-300"
          >
            {messages.email}
          </a>
        </div>

        <p class="mt-6 leading-7 text-zinc-600 dark:text-zinc-400">
          {messages.availability}
        </p>

        <div class="mt-8 border-t border-zinc-200 pt-6 dark:border-zinc-800">
          <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{messages.linksLabel}</p>
          <div class="mt-3 flex flex-wrap gap-3">
            <a
              href="https://github.com/sebas3261"
              target="_blank"
              rel="noreferrer"
              class="rounded-lg border border-zinc-200 px-4 py-2 text-sm font-medium transition-colors hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900"
            >
              {messages.links.github}
            </a>
            <a
              href="https://www.linkedin.com/"
              target="_blank"
              rel="noreferrer"
              class="rounded-lg border border-zinc-200 px-4 py-2 text-sm font-medium transition-colors hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900"
            >
              {messages.links.linkedin}
            </a>
          </div>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>
