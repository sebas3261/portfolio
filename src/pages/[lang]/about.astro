---
import "../../styles/global.css";
import en from "../../messages/en/about.json";
import es from "../../messages/es/about.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/NavBar.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;
---

<BaseLayout lang={lang} messages={messages}>
  <NavBar lang={lang} />

  <main class="bg-white text-zinc-950 dark:bg-zinc-950 dark:text-white">

    <!-- Header -->
    <section class="px-6 pb-16 pt-32 sm:pb-20 sm:pt-40">
      <div class="mx-auto max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.eyebrow}
        </p>
        <h1 class="mt-5 max-w-3xl text-5xl font-semibold tracking-tight sm:text-6xl lg:text-7xl">
          {messages.heading}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-500 dark:text-zinc-400">
          {messages.intro}
        </p>
      </div>
    </section>

    <!-- Bio -->
    <section class="border-t border-zinc-200 px-6 py-16 dark:border-zinc-800 sm:py-20">
      <div class="mx-auto max-w-4xl">
        <p class="max-w-3xl text-xl leading-9 text-zinc-700 dark:text-zinc-300">
          {messages.bio}
        </p>
      </div>
    </section>

    <!-- Focus areas -->
    <section class="border-t border-zinc-200 px-6 py-16 dark:border-zinc-800 sm:py-20">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.focus.title}
        </h2>
        <div class="mt-10 grid gap-px bg-zinc-200 dark:bg-zinc-800 sm:grid-cols-2">
          {messages.focus.items.map((item) => (
            <div class="bg-white p-8 dark:bg-zinc-950">
              <h3 class="text-base font-semibold">{item.title}</h3>
              <p class="mt-3 leading-7 text-zinc-500 dark:text-zinc-400">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="border-t border-zinc-200 px-6 py-16 dark:border-zinc-800 sm:py-20">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.stack.title}
        </h2>
        <div class="mt-10 space-y-6">
          {messages.stack.categories.map((cat) => (
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-8">
              <p class="w-24 shrink-0 text-sm font-semibold text-zinc-950 dark:text-white">{cat.name}</p>
              <div class="flex flex-wrap gap-2">
                {cat.items.map((item) => (
                  <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-sm text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Values / How I work -->
    <section class="border-t border-zinc-200 px-6 py-16 dark:border-zinc-800 sm:py-20">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.values.title}
        </h2>
        <div class="mt-10 space-y-10">
          {messages.values.items.map((item, index) => (
            <div class="flex gap-6 sm:gap-10">
              <p class="mt-0.5 text-2xl font-semibold tabular-nums text-zinc-200 dark:text-zinc-800">
                0{index + 1}
              </p>
              <div>
                <h3 class="text-base font-semibold">{item.title}</h3>
                <p class="mt-2 leading-7 text-zinc-500 dark:text-zinc-400">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-zinc-200 px-6 py-16 dark:border-zinc-800 sm:py-20">
      <div class="mx-auto max-w-4xl flex flex-col gap-3 sm:flex-row">
        <a
          href={`/${lang}/projects/`}
          class="inline-flex items-center justify-center rounded-full bg-zinc-950 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
        >
          {messages.cta.projects}
        </a>
        <a
          href={`/${lang}/contact/`}
          class="inline-flex items-center justify-center rounded-full border border-zinc-300 px-6 py-3 text-sm font-semibold text-zinc-950 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-white dark:hover:bg-zinc-900"
        >
          {messages.cta.contact}
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
