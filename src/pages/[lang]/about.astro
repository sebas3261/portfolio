---
import "../../styles/global.css";
import en from "../../messages/en/about.json";
import es from "../../messages/es/about.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/NavBar.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;
---

<BaseLayout lang={lang} messages={messages}>
  <NavBar lang={lang} />

  <main class="bg-white text-zinc-950 dark:bg-zinc-950 dark:text-white">

    <section class="bg-zinc-50 px-6 pb-16 pt-28 dark:bg-zinc-900/40 sm:pb-24 sm:pt-40">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[minmax(0,1fr)_26rem] lg:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-sky-500 dark:text-sky-400">
            {messages.eyebrow}
          </p>
          <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight sm:text-6xl lg:text-7xl">
            {messages.heading}
          </h1>
          <span class="mt-6 block h-1 w-24 bg-gradient-to-r from-sky-400 via-violet-400 to-emerald-400"></span>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-500 dark:text-zinc-400">
            {messages.intro}
          </p>
        </div>

        <div class="relative max-w-sm justify-self-center sm:max-w-md lg:max-w-none lg:justify-self-auto">
          <div class="aspect-[5/4] overflow-hidden rounded-sm bg-zinc-200 dark:bg-zinc-900 lg:aspect-[4/5]">
            <img
              src="/images/about/sebastian.jpg"
              alt={messages.photoAlt}
              width="1200"
              height="1600"
              class="h-full w-full object-cover object-[50%_85%]"
              loading="eager"
              decoding="async"
              onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden')"
            />
            <div class="hidden h-full w-full place-items-center bg-[linear-gradient(135deg,rgba(14,165,233,0.12),rgba(139,92,246,0.08),rgba(16,185,129,0.10))] grid">
              <span class="text-7xl font-semibold tracking-tight text-zinc-300 dark:text-zinc-700">SS</span>
            </div>
          </div>
          <div class="mt-4 border-l-2 border-sky-300 pl-4 dark:border-sky-700">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-500 dark:text-sky-400">{messages.profileLabel}</p>
            <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
              {messages.profileNote}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-zinc-200 px-6 py-10 dark:border-zinc-800">
      <div class="mx-auto grid max-w-7xl gap-8 sm:grid-cols-3">
        {messages.quickFacts.map((fact, index) => {
          const accents = ["border-sky-400", "border-violet-400", "border-emerald-400"];
          return (
          <div class={`border-t pt-5 ${accents[index]}`}>
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">{fact.label}</p>
            <p class="mt-2 text-lg font-semibold">{fact.value}</p>
          </div>
          );
        })}
      </div>
    </section>

    <section class="border-t border-zinc-200 bg-white px-6 py-12 dark:border-zinc-800 dark:bg-zinc-950 sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <h2 class="border-l-2 border-sky-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.story.title}
        </h2>
        <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
          <p class="text-xl leading-8 tracking-tight text-zinc-800 dark:text-zinc-200 sm:text-2xl sm:leading-9">
            {messages.bio}
          </p>
          <div class="space-y-4">
            {messages.story.paragraphs.map((paragraph) => (
              <p class="max-w-3xl text-base leading-7 text-zinc-500 dark:text-zinc-400">
                {paragraph}
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="vaul" class="scroll-mt-20 bg-zinc-950 px-6 py-14 text-white sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.1fr_0.9fr] lg:gap-20">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-300">{messages.company.eyebrow}</p>
          <div class="mt-6 flex items-center gap-4"><img src="/images/vaul/vaul-white.svg" alt="" width="80" height="50" class="h-12 w-20 object-contain" /><h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{messages.company.title}</h2></div>
          <p class="mt-6 max-w-xl text-base leading-8 text-zinc-400">{messages.company.body}</p>
          <a href={`https://vaulsoftware.com/${lang}/`} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-indigo-300 hover:text-white">{messages.company.cta}<span aria-hidden="true">↗</span></a>
        </div>
        <div class="grid gap-4 content-center">
          {messages.company.projects.map(project => (
            <a href={`/${lang}/projects/${project.slug}/`} class="group flex items-center gap-4 rounded-xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-indigo-300/40 hover:bg-white/[0.06]">
              <img src={project.slug === "courtrank" ? "/images/courtrank.png" : "/images/projects/playzone-logo.webp"} alt="" width="48" height="48" class="size-12 object-contain" />
              <div><h3 class="text-lg font-semibold">{project.name}</h3><p class="mt-1 text-sm text-zinc-400">{project.body}</p></div><span class="ml-auto text-zinc-500 group-hover:text-white" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-zinc-200 bg-zinc-100 px-6 py-14 dark:border-zinc-800 dark:bg-zinc-900/40 sm:py-16">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <h2 class="border-l-2 border-violet-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.now.title}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {messages.now.items.map((item, index) => {
            const colors = ["text-sky-500", "text-violet-500", "text-emerald-500", "text-rose-500"];
            return (
            <div class="border-t border-zinc-300 pt-5 dark:border-zinc-800">
              <p class={`text-sm font-semibold ${colors[index]}`}>0{index + 1}</p>
              <p class="mt-3 leading-7 text-zinc-700 dark:text-zinc-300">{item}</p>
            </div>
            );
          })}
        </div>
      </div>
    </section>

    <section id="focus" class="scroll-mt-20 px-6 py-16 sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
        <figure>
          <img src="/images/about/workspace-new.webp" alt={lang === "es" ? "Portátil con código y luz azul junto a una ventana" : "Laptop displaying code beside a blue-lit window"} width="1600" height="1067" class="aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />
          <figcaption class="mt-3 text-[11px] text-zinc-400">{messages.photoLabel} · <a href="https://unsplash.com/photos/a-laptop-computer-sitting-on-top-of-a-desk-ysZnFnexwRE" target="_blank" rel="noopener noreferrer" class="hover:underline">Alexander Nrjwolf / Unsplash</a></figcaption>
        </figure>
        <div>
          <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{messages.focus.title}</h2>
          <div class="mt-8 grid gap-7 sm:grid-cols-2">
            {messages.focus.items.map(item => <div class="border-t border-zinc-200 pt-4 dark:border-zinc-800"><h3 class="text-base font-semibold">{item.title}</h3><p class="mt-3 text-sm leading-7 text-zinc-500 dark:text-zinc-400">{item.body}</p></div>)}
          </div>
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="border-t border-zinc-200 bg-white px-6 py-14 dark:border-zinc-800 dark:bg-zinc-950 sm:py-16">
      <div class="mx-auto max-w-7xl">
        <h2 class="border-l-2 border-sky-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.stack.title}
        </h2>
        <div class="mt-10 space-y-6">
          {messages.stack.categories.map((cat) => (
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-8">
              <p class="w-24 shrink-0 text-sm font-semibold text-zinc-950 dark:text-white">{cat.name}</p>
              <div class="flex flex-wrap gap-2">
                {cat.items.map((item) => (
                    <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-sm text-zinc-600 transition-colors hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-sky-900 dark:hover:bg-sky-950/30 dark:hover:text-sky-300">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Values / How I work -->
    <section id="how-i-work" class="scroll-mt-20 border-t border-zinc-200 bg-zinc-50 px-6 py-16 dark:border-zinc-800 dark:bg-zinc-900/40 sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2 lg:items-center lg:gap-20">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{messages.values.title}</h2>
          <div class="mt-8 space-y-7">
            {messages.values.items.map((item, index) => <div class="flex gap-5"><span class="text-sm font-semibold text-indigo-500 dark:text-indigo-300">0{index + 1}</span><div><h3 class="text-lg font-semibold">{item.title}</h3><p class="mt-2 text-sm leading-7 text-zinc-500 dark:text-zinc-400">{item.body}</p></div></div>)}
          </div>
        </div>
        <figure>
          <img src="/images/about/notes.webp" alt={lang === "es" ? "Cuaderno abierto con una pluma sobre una mesa de madera" : "Open notebook with a fountain pen on a wooden table"} width="1600" height="1200" class="aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />
          <figcaption class="mt-3 text-[11px] text-zinc-400">{messages.photoLabel} · <a href="https://unsplash.com/photos/gray-and-black-fountain-pen-and-book-o-ubWHV29Uk" target="_blank" rel="noopener noreferrer" class="hover:underline">Aaron Burden / Unsplash</a></figcaption>
        </figure>
      </div>
    </section>

    <section class="px-6 py-12 sm:py-16">
      <div class="mx-auto grid max-w-7xl gap-6 md:grid-cols-2 md:items-center">
        <div><h2 class="text-2xl font-semibold tracking-tight">{messages.outsideCode.title}</h2><p class="mt-3 max-w-lg text-sm leading-7 text-zinc-500 dark:text-zinc-400">{messages.outsideCode.intro}</p></div>
        <div class="flex flex-wrap gap-3">{messages.outsideCode.items.map(item => <span class="rounded-full border border-zinc-200 px-4 py-2 text-sm text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">{item}</span>)}</div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-zinc-200 bg-white px-6 py-16 dark:border-zinc-800 dark:bg-zinc-950 sm:py-20">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 sm:flex-row">
        <a
          href={`/${lang}/projects/`}
          class="inline-flex items-center justify-center rounded-full bg-zinc-950 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
        >
          {messages.cta.projects}
        </a>
        <a
          href={`/${lang}/contact/`}
          class="inline-flex items-center justify-center rounded-full border border-zinc-300 px-6 py-3 text-sm font-semibold text-zinc-950 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-white dark:hover:bg-zinc-900"
        >
          {messages.cta.contact}
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
