---
import "../../styles/global.css";
import en from "../../messages/en/about.json";
import es from "../../messages/es/about.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/NavBar.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;
---

<BaseLayout lang={lang} messages={messages}>
  <NavBar lang={lang} />

  <main class="bg-white text-zinc-950 dark:bg-zinc-950 dark:text-white">

    <section class="bg-zinc-50 px-6 pb-16 pt-28 dark:bg-zinc-900/40 sm:pb-24 sm:pt-40">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[minmax(0,1fr)_26rem] lg:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-sky-500 dark:text-sky-400">
            {messages.eyebrow}
          </p>
          <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight sm:text-6xl lg:text-7xl">
            {messages.heading}
          </h1>
          <span class="mt-6 block h-1 w-24 bg-gradient-to-r from-sky-400 via-violet-400 to-emerald-400"></span>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-500 dark:text-zinc-400">
            {messages.intro}
          </p>
        </div>

        <div class="relative max-w-sm justify-self-center sm:max-w-md lg:max-w-none lg:justify-self-auto">
          <div class="aspect-[5/4] overflow-hidden rounded-sm bg-zinc-200 dark:bg-zinc-900 lg:aspect-[4/5]">
            <img
              src="/images/sebastian.webp"
              alt={messages.photoAlt}
              class="h-full w-full scale-[1.08] object-cover object-[50%_56%] lg:object-[50%_58%]"
              loading="eager"
              decoding="async"
              onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden')"
            />
            <div class="hidden h-full w-full place-items-center bg-[linear-gradient(135deg,rgba(14,165,233,0.12),rgba(139,92,246,0.08),rgba(16,185,129,0.10))] grid">
              <span class="text-7xl font-semibold tracking-tight text-zinc-300 dark:text-zinc-700">SS</span>
            </div>
          </div>
          <div class="absolute -bottom-6 -left-6 hidden w-56 border border-sky-200 bg-white p-5 shadow-sm dark:border-sky-900/60 dark:bg-zinc-950 lg:block">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-500 dark:text-sky-400">{messages.profileLabel}</p>
            <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
              {messages.profileNote}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-zinc-200 px-6 py-10 dark:border-zinc-800">
      <div class="mx-auto grid max-w-7xl gap-8 sm:grid-cols-3">
        {messages.quickFacts.map((fact, index) => {
          const accents = ["border-sky-400", "border-violet-400", "border-emerald-400"];
          return (
          <div class={`border-t pt-5 ${accents[index]}`}>
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">{fact.label}</p>
            <p class="mt-2 text-lg font-semibold">{fact.value}</p>
          </div>
          );
        })}
      </div>
    </section>

    <section class="border-t border-zinc-200 bg-white px-6 py-12 dark:border-zinc-800 dark:bg-zinc-950 sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <h2 class="border-l-2 border-sky-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.story.title}
        </h2>
        <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
          <p class="text-xl leading-8 tracking-tight text-zinc-800 dark:text-zinc-200 sm:text-2xl sm:leading-9">
            {messages.bio}
          </p>
          <div class="space-y-4">
            {messages.story.paragraphs.map((paragraph) => (
              <p class="max-w-3xl text-base leading-7 text-zinc-500 dark:text-zinc-400">
                {paragraph}
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-zinc-200 bg-zinc-100 px-6 py-14 dark:border-zinc-800 dark:bg-zinc-900/40 sm:py-16">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <h2 class="border-l-2 border-violet-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.now.title}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {messages.now.items.map((item, index) => {
            const colors = ["text-sky-500", "text-violet-500", "text-emerald-500", "text-rose-500"];
            return (
            <div class="border-t border-zinc-300 pt-5 dark:border-zinc-800">
              <p class={`text-sm font-semibold ${colors[index]}`}>0{index + 1}</p>
              <p class="mt-3 leading-7 text-zinc-700 dark:text-zinc-300">{item}</p>
            </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="border-t border-zinc-200 bg-white px-6 py-14 dark:border-zinc-800 dark:bg-zinc-950 sm:py-16">
      <div class="mx-auto max-w-7xl">
        <h2 class="border-l-2 border-sky-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.stack.title}
        </h2>
        <div class="mt-10 space-y-6">
          {messages.stack.categories.map((cat) => (
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-8">
              <p class="w-24 shrink-0 text-sm font-semibold text-zinc-950 dark:text-white">{cat.name}</p>
              <div class="flex flex-wrap gap-2">
                {cat.items.map((item) => (
                    <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-sm text-zinc-600 transition-colors hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-sky-900 dark:hover:bg-sky-950/30 dark:hover:text-sky-300">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Values / How I work -->
    <section class="border-t border-zinc-200 bg-zinc-50 px-6 py-14 dark:border-zinc-800 dark:bg-zinc-900/40 sm:py-16">
      <div class="mx-auto max-w-7xl">
        <h2 class="border-l-2 border-violet-400 pl-4 text-xs font-semibold uppercase tracking-[0.28em] text-zinc-400">
          {messages.values.title}
        </h2>
        <div class="mt-10 space-y-10">
          {messages.values.items.map((item, index) => (
            <div class="flex gap-6 sm:gap-10">
              <p class="mt-0.5 text-2xl font-semibold tabular-nums text-violet-500 dark:text-violet-300">
                0{index + 1}
              </p>
              <div>
                <h3 class="text-base font-semibold">{item.title}</h3>
                <p class="mt-2 leading-7 text-zinc-500 dark:text-zinc-400">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-zinc-200 bg-white px-6 py-16 dark:border-zinc-800 dark:bg-zinc-950 sm:py-20">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 sm:flex-row">
        <a
          href={`/${lang}/projects/`}
          class="inline-flex items-center justify-center rounded-full bg-zinc-950 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
        >
          {messages.cta.projects}
        </a>
        <a
          href={`/${lang}/contact/`}
          class="inline-flex items-center justify-center rounded-full border border-zinc-300 px-6 py-3 text-sm font-semibold text-zinc-950 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-white dark:hover:bg-zinc-900"
        >
          {messages.cta.contact}
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
