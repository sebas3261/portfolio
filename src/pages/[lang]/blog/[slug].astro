---
import ContentArticle from "../../../components/ContentArticle.astro";
import { getBlogPost } from "../../../lib/blog";
export const prerender = false;
const lang = Astro.params.lang === "es" ? "es" : "en";
const slug = Astro.params.slug ?? "";
const post = await getBlogPost(lang, slug);
if (!post) {
  const video = await getBlogPost(lang, slug, "videos");
  if (video) return Astro.redirect(`/${lang}/videos/${slug}/`, 301);
  return Astro.redirect(`/${lang}/404/`);
}
---
<ContentArticle section="blog" post={post} />
