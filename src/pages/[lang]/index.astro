---
import "../../styles/global.css";
import en from "../../messages/en/index.json";
import es from "../../messages/es/index.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar  from "../../components/NavBar.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
const messages = lang === "es" ? es : en;
const heroTechnologies = [
  ...messages.hero.technologies,
  ...messages.hero.technologies,
];
const expertiseIcons: Record<string, string> = {
  "Java": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg",
  "Spring Boot": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/spring/spring-original.svg",
  "Node.js": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg",
  "PostgreSQL": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg",
  "Docker": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg",
  "React": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg",
  "Next.js": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nextjs/nextjs-original.svg",
  "Astro": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg",
  "TypeScript": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg",
  "Tailwind CSS": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg",
  "HTML & CSS": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg",
  "AWS": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-original-wordmark.svg",
  "Linux": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linux/linux-original.svg",
  "Git": "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg",
};
const expertiseFallbackIcon = `<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.456-2.456L14.25 6l1.035-.259a3.375 3.375 0 0 0 2.456-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" /></svg>`;
---

<BaseLayout lang={lang} messages={messages}>
  <NavBar lang={lang} variant="heroDark" />

  <main class="overflow-x-hidden">
  <!-- Hero -->
  <section id="hero" class="relative isolate overflow-hidden bg-zinc-950 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_85%_35%,rgba(79,112,255,0.14),transparent_52%)]"></div>
    <div class="mx-auto flex min-h-svh max-w-7xl flex-col px-6 pt-24 pb-8 sm:px-8 sm:pt-28 lg:px-10">
      <div class="grid flex-1 items-center gap-10 py-8 md:grid-cols-[minmax(0,1.4fr)_minmax(0,0.8fr)] lg:gap-20 sm:py-10">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.24em] text-zinc-400">{messages.hero.eyebrow}</p>
        <h1 class="mt-6 text-[clamp(3.25rem,7vw,6rem)] font-semibold leading-[0.98] tracking-[-0.06em]">
          <span class="block">{messages.hero.heading}</span>
          <span class="block text-indigo-300">{messages.hero.headingAccent}</span>
        </h1>
        <div class="mt-8 grid gap-7 lg:mt-10">
          <p class="max-w-xl text-base leading-7 text-zinc-400 sm:text-lg sm:leading-8">{messages.hero.description}</p>
          <div class="flex flex-wrap items-center gap-5">
            <a href="#selected-work" class="inline-flex items-center gap-3 rounded-full bg-white px-6 py-3 text-sm font-semibold text-zinc-950 transition-colors hover:bg-zinc-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
              {messages.hero.primaryCta}<span aria-hidden="true">↘</span>
            </a>
            <a href={`https://vaulsoftware.com/${lang}/`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white" aria-label={messages.projectsPreview.company.cta}>
              <img src="/images/vaul/vaul-white.svg" width="32" height="20" alt="" class="h-5 w-8 object-contain" />
              VAUL Software<span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
      <figure class="relative mx-auto w-full max-w-xs md:ml-auto md:mr-0 lg:max-w-sm">
        <div aria-hidden="true" class="pointer-events-none absolute -inset-10 -z-10 rounded-full bg-indigo-500/10 blur-3xl"></div>
        <div class="aspect-[4/5] overflow-hidden rounded-lg border border-indigo-300/20 bg-zinc-900 shadow-[0_20px_70px_-25px_rgba(79,112,255,0.25)]">
          <img src="/images/sebastian.webp" alt={messages.hero.portraitAlt} width="664" height="1182" loading="eager" fetchpriority="high" decoding="async" class="h-full w-full object-cover object-[50%_70%]" />
        </div>
        <figcaption class="mt-4 flex items-center justify-between gap-3 text-xs text-zinc-500">
          <span>Sebastian Sanchez</span>
          <span>{messages.hero.portraitCaption}</span>
        </figcaption>
      </figure>
      </div>
      <div class="mt-10 border-t border-white/10 pt-6">
        <div class="flex flex-wrap items-center justify-between gap-3 text-[11px] uppercase tracking-[0.18em] text-zinc-500">
          <p>{messages.hero.techLabel}</p>
          <p>{messages.hero.location} · {messages.hero.availability}</p>
        </div>
        <div class="tech-marquee-mask mt-5 overflow-hidden">
          <div class="tech-marquee-track flex w-max items-center gap-4">
            {heroTechnologies.map((technology, index) => (
              <div aria-hidden={index >= messages.hero.technologies.length ? "true" : undefined} class="flex h-11 shrink-0 items-center gap-3 rounded-full border border-white/10 px-4 text-sm font-medium text-zinc-300">
                <img src={technology.icon} alt="" class="size-5 object-contain brightness-0 invert" loading="lazy" decoding="async" />
                <span>{technology.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About preview -->
  <section id="about-preview" class="scroll-mt-16 grid place-items-center border-t border-zinc-200 bg-white px-6 pt-16 pb-8 text-zinc-950 dark:border-zinc-800 dark:bg-zinc-950 dark:text-white sm:pt-24 sm:pb-10">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">

        <!-- Left: text -->
        <div class="flex flex-col justify-center">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">
            {messages.aboutPreview.eyebrow}
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">
            {messages.aboutPreview.heading}
          </h2>
          <p class="mt-5 text-base leading-7 text-zinc-500 dark:text-zinc-400">
            {messages.aboutPreview.bio}
          </p>
          <div class="mt-8">
            <p class="text-sm leading-6 text-zinc-500 dark:text-zinc-400">{messages.projectsPreview.company.eyebrow}</p>
            <a href={`https://vaulsoftware.com/${lang}/`} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-4 focus-visible:outline-2 focus-visible:outline-offset-4" aria-label={messages.projectsPreview.company.cta}>
              <img src="/images/vaul/vaul-color.svg" alt="" width="80" height="50" class="h-12 w-20 object-contain dark:hidden" />
              <img src="/images/vaul/vaul-white.svg" alt="" width="80" height="50" class="hidden h-12 w-20 object-contain dark:block" />
              <span class="text-2xl font-semibold tracking-tight sm:text-3xl">VAUL Software</span><span aria-hidden="true">↗</span>
            </a>
          </div>
          <a
            href={`/${lang}/about/`}
            class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-zinc-950 underline-offset-4 transition-colors hover:text-zinc-500 dark:text-white dark:hover:text-zinc-400"
          >
            {messages.aboutPreview.cta}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Right: bullets + decorative note -->
        <div class="relative flex flex-col justify-center gap-3">
          {messages.aboutPreview.bullets.map((bullet) => {
            const bulletIcons: Record<string, string> = {
              location: `<svg class="size-4 shrink-0 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>`,
              remote:   `<svg class="size-4 shrink-0 text-violet-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3"/></svg>`,
              learning: `<svg class="size-4 shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 3.741-1.342"/></svg>`,
              hobby:    `<svg class="size-4 shrink-0 text-rose-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>`,
            };
            return (
              <div class="flex items-center gap-4 border-b border-zinc-100 py-4 dark:border-zinc-800 last:border-b-0">
                <span set:html={bulletIcons[bullet.icon] ?? bulletIcons.location} />
                <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{bullet.text}</span>
              </div>
            );
          })}
          <!-- Decorative note -->
          <p class="mt-4 text-right text-sm italic text-zinc-400">
            Always building<br/>what's next. ↗
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Projects preview -->
  <section id="selected-work" class="scroll-mt-24 grid place-items-center bg-white px-6 pt-8 pb-16 text-zinc-950 dark:bg-zinc-950 dark:text-white sm:pt-10 sm:pb-28">
    <div class="mx-auto max-w-7xl">

      <!-- Header row -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">
            {messages.projectsPreview.eyebrow}
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">
            {messages.projectsPreview.heading}
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-7 text-zinc-500 dark:text-zinc-400">
            {messages.projectsPreview.intro}
          </p>
        </div>
        <a
          href={`/${lang}/projects/`}
          class="shrink-0 inline-flex items-center gap-2 rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800"
        >
          {messages.projectsPreview.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>



      <div class="mt-12 grid gap-x-10 gap-y-14 md:grid-cols-2 lg:gap-x-14 lg:gap-y-20">
        {messages.projectsPreview.items.map((project, index) => (
          <article id={`project-${project.slug}`} class:list={[
            "group grid gap-6",
            index === 0
              ? "md:col-span-2 md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] md:items-center lg:gap-14"
              : "content-start border-t border-zinc-200 pt-8 dark:border-zinc-800",
          ]}>

            <div class="overflow-hidden rounded-xl border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
              <div class="flex h-8 items-center gap-1.5 border-b border-zinc-200 px-3 dark:border-zinc-800" aria-hidden="true">
                <span class="size-1.5 rounded-full bg-zinc-400/50"></span><span class="size-1.5 rounded-full bg-zinc-400/50"></span><span class="size-1.5 rounded-full bg-zinc-400/50"></span>
                <span class="ml-2 truncate text-[10px] text-zinc-500">{new URL(project.url).hostname}</span>
              </div>
            <div class="project-mockup relative aspect-[16/10] overflow-hidden bg-zinc-100 dark:bg-zinc-900">
              {project.image ? (
                <img src={project.image} alt={project.name} class="h-full w-full object-cover object-top" />
              ) : project.url ? (
                <>
                  {/* Wrapper escalado — pointer-events-none para no interferir con el link overlay */}
                  <div class="pointer-events-none absolute inset-0" data-iframe-container>
                    <div class="absolute left-0 top-0 origin-top-left" data-iframe-inner style="width:1280px;">
                      <iframe
                        src={project.url}
                        title={project.name}
                        loading="eager"
                        scrolling="no"
                        class="block h-[800px] w-[1280px] border-0"
                        data-project-iframe
                      />
                    </div>
                  </div>
                  {/* Link overlay encima — hace clic llevar a la URL */}
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute inset-0 z-30 flex items-end justify-end p-3 opacity-0 transition-opacity duration-200 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-white"
                    aria-label={`${messages.projectsPreview.openSite}: ${project.name}`}
                  >
                    <span class="flex items-center gap-1.5 rounded-full bg-zinc-950/80 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-sm">
                      {messages.projectsPreview.openSite}
                      <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
                    </span>
                  </a>
                  {/* Fallback si iframe bloqueado */}
                  <div class="project-iframe-overlay absolute inset-0 z-20 hidden items-center justify-center bg-zinc-100 dark:bg-zinc-800">
                    <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.04)_1px,transparent_1px)] bg-[size:24px_24px] dark:bg-[linear-gradient(rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.04)_1px,transparent_1px)]"></div>
                    <p class="relative z-10 text-xl font-bold tracking-tight text-zinc-300 dark:text-zinc-600">{project.name}</p>
                  </div>
                </>
              ) : (
                <>
                  <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.04)_1px,transparent_1px)] bg-[size:24px_24px] dark:bg-[linear-gradient(rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.04)_1px,transparent_1px)]"></div>
                  <p class="absolute inset-0 flex items-center justify-center text-xl font-bold tracking-tight text-zinc-300 dark:text-zinc-600">{project.name}</p>
                </>
              )}
            </div>
            </div>
            <div class="flex flex-1 flex-col">
              <div class="grid gap-4 sm:grid-cols-[auto_1fr]">
                <span class="text-sm font-semibold text-zinc-300 dark:text-zinc-700">0{index + 1}</span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">{project.type}</p>
                  <h3 class:list={["mt-2 font-semibold tracking-tight", index === 0 ? "text-3xl sm:text-5xl" : "text-2xl sm:text-3xl"]}>{project.name}</h3>
                </div>
              </div>
              <p class="mt-5 flex-1 text-base leading-7 text-zinc-500 dark:text-zinc-400">
                {project.description}
              </p>

              <dl class="mt-5 grid gap-3">
                <div>
                  <dt class="sr-only">{messages.projectsPreview.roleLabel}</dt>
                  <dd class="text-sm leading-6 text-zinc-500 dark:text-zinc-400">{project.role}</dd>
                </div>
                <div>
                  <dt class="sr-only">{messages.projectsPreview.outcomeLabel}</dt>
                  <dd class="border-l-2 border-emerald-500/60 pl-3 text-sm leading-6 text-zinc-700 dark:text-zinc-300">{project.outcome}</dd>
                </div>
              </dl>

              <div class="mt-5 flex flex-wrap gap-2">
                {project.stack.map((tech) => (
                  <span class="rounded-full border border-zinc-200 px-2.5 py-0.5 text-xs font-medium text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="mt-6 flex items-center gap-4">
                <a
                  href={`/${lang}/projects/${project.slug}/`}
                  class="inline-flex items-center gap-1 text-sm font-semibold text-zinc-950 transition-all hover:text-zinc-500 dark:text-white dark:hover:text-zinc-400"
                >
                  {project.cta}
                  <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
              </div>
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Expertise -->
  <section class="grid place-items-center overflow-hidden border-t border-zinc-200 bg-zinc-100 px-6 py-16 text-zinc-950 dark:border-zinc-800 dark:bg-zinc-900 dark:text-white sm:py-28 md:min-h-dvh">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div class="relative">
          <div class="absolute -left-20 top-4 hidden h-64 w-64 rounded-full border border-zinc-300/60 dark:border-white/10 lg:block"></div>
          <div class="absolute -left-10 top-24 hidden h-32 w-32 rounded-full border border-sky-300/60 dark:border-cyan-400/20 lg:block"></div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">
            {messages.expertise.eyebrow}
          </p>
          <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-5xl">
            {messages.expertise.heading}
          </h2>
          <p class="mt-5 max-w-md text-base leading-7 text-zinc-500 dark:text-zinc-400">
            {messages.expertise.intro}
          </p>
          <div class="mt-10 hidden items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400 lg:flex">
            <span class="h-px w-12 bg-sky-400/60"></span>
            Product systems stack
          </div>
        </div>

        <div class="relative">
          <div class="absolute bottom-8 left-5 top-8 hidden w-px bg-gradient-to-b from-sky-400 via-violet-300 to-emerald-400 opacity-50 dark:via-violet-200 dark:opacity-70 sm:block"></div>
          <div class="space-y-8">
            {messages.expertise.categories.map((cat, i) => {
              const accents = [
                "border-sky-400 text-sky-600 dark:text-sky-300",
                "border-violet-400 text-violet-600 dark:border-violet-300 dark:text-violet-200",
                "border-emerald-400 text-emerald-600 dark:text-emerald-300",
              ];
              const accent = accents[i];
              return (
                <div class="grid gap-5 sm:grid-cols-[2.75rem_1fr]">
                  <div class={`relative z-10 flex size-10 items-center justify-center rounded-full border bg-zinc-100 text-xs font-semibold dark:bg-zinc-900 ${accent}`}>
                    0{i + 1}
                  </div>
              <div>
                    <div class="flex flex-col gap-3 border-b border-zinc-300 pb-8 dark:border-white/10 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        <h3 class="text-2xl font-semibold tracking-tight">{cat.name}</h3>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-500 dark:text-zinc-400">
                          {cat.description}
                        </p>
                      </div>
                      <span class={`shrink-0 border-t pt-2 text-xs font-semibold uppercase tracking-[0.2em] ${accent}`}>
                        Layer
                      </span>
                    </div>
                    <div class="mt-5 flex flex-wrap gap-2">
                      {cat.items.map((item) => (
                        <span class="inline-flex items-center gap-2 rounded-full border border-zinc-300 bg-white/45 px-3 py-1.5 text-xs font-medium text-zinc-700 transition-colors hover:border-zinc-400 hover:bg-white dark:border-white/10 dark:bg-white/[0.03] dark:text-zinc-200 dark:hover:border-white/25 dark:hover:bg-white/[0.06]">
                          {expertiseIcons[item] ? (
                            <img
                              src={expertiseIcons[item]}
                              alt=""
                              class="size-4 object-contain"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <span class="text-zinc-400 dark:text-zinc-500" set:html={expertiseFallbackIcon} />
                          )}
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
              </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="grid place-items-center border-t border-zinc-200 bg-zinc-50 px-6 py-16 dark:border-zinc-800 dark:bg-zinc-900 sm:py-20 md:min-h-dvh">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">
            {messages.closing.eyebrow}
          </p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
            {messages.closing.heading}
          </h2>
          <p class="mt-2 max-w-xl text-base text-zinc-500 dark:text-zinc-400">
            {messages.closing.description}
          </p>
        </div>
        <a
          href={`/${lang}/contact/`}
          class="shrink-0 inline-flex items-center justify-center gap-2 rounded-full bg-zinc-950 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
        >
          {messages.closing.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
  </main>

  <script>
    const IFRAME_W = 1280;
    const IFRAME_H = 800;

    function scaleIframes() {
      document.querySelectorAll<HTMLElement>(".project-mockup").forEach((mockup) => {
        const inner = mockup.querySelector<HTMLElement>("[data-iframe-inner]");
        if (!inner) return;
        const scaleX = mockup.clientWidth / IFRAME_W;
        const scaleY = mockup.clientHeight / IFRAME_H;
        // Usamos el menor para que quepa completo, pero queremos cubrir el ancho
        const scale = scaleX;
        inner.style.transform = `scale(${scale})`;
        inner.style.transformOrigin = "top left";
        // La altura visual tras escalar
        inner.style.height = `${IFRAME_H}px`;
      });
    }

    scaleIframes();
    window.addEventListener("resize", scaleIframes);

    // Fallback visual si el iframe no emite load. En cross-origin no se puede leer
    // contentDocument de forma confiable, porque el navegador lo bloquea aunque haya cargado.
    document.querySelectorAll<HTMLIFrameElement>("[data-project-iframe]").forEach((iframe) => {
      const mockup = iframe.closest<HTMLElement>(".project-mockup");
      const overlay = mockup?.querySelector<HTMLElement>(".project-iframe-overlay");
      if (!overlay) return;

      const showFallback = () => {
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
      };

      const timer = setTimeout(showFallback, 9000);

      iframe.addEventListener("load", () => {
        clearTimeout(timer);
      });

      iframe.addEventListener("error", () => {
        clearTimeout(timer);
        showFallback();
      });
    });

  </script>
</BaseLayout>
