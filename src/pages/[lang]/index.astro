  </main>

  <script>
    const IFRAME_W = 1280;
    const IFRAME_H = 800;

    function scaleIframes() {
      document.querySelectorAll<HTMLElement>(".project-mockup").forEach((mockup) => {
        const inner = mockup.querySelector<HTMLElement>("[data-iframe-inner]");
        if (!inner) return;
        const scaleX = mockup.clientWidth / IFRAME_W;
        const scaleY = mockup.clientHeight / IFRAME_H;
        // Usamos el menor para que quepa completo, pero queremos cubrir el ancho
        const scale = scaleX;
        inner.style.transform = `scale(${scale})`;
        inner.style.transformOrigin = "top left";
        // La altura visual tras escalar
        inner.style.height = `${IFRAME_H}px`;
      });
    }

    scaleIframes();
    window.addEventListener("resize", scaleIframes);

    // Fallback visual si el iframe no emite load. En cross-origin no se puede leer
    // contentDocument de forma confiable, porque el navegador lo bloquea aunque haya cargado.
    document.querySelectorAll<HTMLIFrameElement>("[data-project-iframe]").forEach((iframe) => {
      const mockup = iframe.closest<HTMLElement>(".project-mockup");
      const overlay = mockup?.querySelector<HTMLElement>(".project-iframe-overlay");
      if (!overlay) return;

      const showFallback = () => {
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
      };

      const timer = setTimeout(showFallback, 9000);

      iframe.addEventListener("load", () => {
        clearTimeout(timer);
      });

      iframe.addEventListener("error", () => {
        clearTimeout(timer);
        showFallback();
      });
    });

  </script>
</BaseLayout>
